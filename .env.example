# Copy to `.env` when you need to override a default.
# `.env` is git-ignored.

# ── API ────────────────────────────────────────────────────────
# Express API port (also used for the production build).
PORT=8787

# Postgres connection. Optional while the app runs on mock data.
# DATABASE_URL=postgres://user:password@host:5432/firerecord

# ── Web (development) ──────────────────────────────────────────
# Vite dev server port.
WEB_PORT=5180

# Only needed when the UI is served from a different origin than
# the API (e.g. a hosted frontend calling a remote API).
# VITE_API_BASE=https://api.example.org
