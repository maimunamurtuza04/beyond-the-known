{
  "name": "beyond-the-known",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A public window into a harmonized MODIS + VIIRS fire record.",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "preview": "npm run build && npm run start"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "echarts": "^5.5.1",
    "express": "^4.21.1",
    "maplibre-gl": "^4.7.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "vite": "^5.4.10"
  }
}
